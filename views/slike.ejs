<!--DODATI ŠTO NEDOSTAJE!-->
<!DOCTYPE html>
	<html lang="hr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<!--dodati meta tag bitan za stranicu-->
		<!--dodati link za css dokumente -->
		<link rel="stylesheet" href="/style/style.css">
		<link rel="stylesheet" href="/style/style_slike.css">
		<title>Music Info</title> <!--promijeniti odgovarajući tekst na stranici
		ovo je samo predložak-->
	</head>
	<body>
		<header>
		<h1>Music Stats</h1>
		</header>
		<!-- <header>
       <nav aria-labelledby="primarna-navigacija">
        <h2 id="primarna-navigacija">Primarna navigacija</h2>
        
        </nav>
        </header>
    -->
		<nav class="nav-menu">
			<input type="checkbox" id="menu-toggle">
			<label for="menu-toggle" class="menu-icon" aria-label="Toggle menu">☰</label>
			 <!-- dodati obilježja za ARIA-->
			<ul class="menu">
				<li><a href="/">Home</a></li>
				<li><a href="/chart.html">Chart</a></li>
				<li><a href="/slike">Gallery</a></li>
			</ul>
		</nav>
		
		<h1>Gallery</h1>

		<section class="galerija"> 

		<!-- putanja (href) u tagu a je drugačija kad se koristi lightbox od onoga kada želimo da se 
						otvori u novom tabu -->

			<section class="img-gallery-grid">
                <% images.forEach((image, index)=>{%>
                    <figure class="galerija_slika">
                        <a href="#img<%= index %>">
                            <img src="<%= image.url %>" alt="<%= image.alt %>" loading="lazy">
                        </a>
                        <figcaption><%= image.title %></figcaption>
                    </figure>
                    <div id="img<%= index %>" class="lightbox" role="dialog" aria-modal="true">
                        <a href="#!" class="close" aria-label="Zatvori sliku">&times;</a>
                        <img src="<%= image.url %>" alt="<%= image.alt %>">
                    </div>
                <% });%>
			</section>
		</section>
			

		<!--dodati odgovarajuće elemente na temelju danog zadatka: tablice, slike, tekst
		Nepotrebno obrisati! -->
		<footer>
			<p>&copy; 2026. Web Programiranje. Sva prava pridrzana.</p>
		</footer>
	</body>
	</html>






